  m_Name: TipTable
  m_EditorClassIdentifier: QL.UI::QL.UI.Data.TipTable
  tips:
  - "\uAC19\uC740 \uB4DC\uB860 \uB450 \uB300\uB97C \uACB9\uCE58\uBA74 \uC0C1\uC704
    \uBAA8\uB378\uB85C \uACB0\uD569\uB3FC\uC694"
  - "Space \uD0A4\uB85C\uB3C4 \uB4DC\uB860\uC744 \uBC14\uB85C \uC18C\uD658\uD560
    \uC218 \uC788\uC5B4\uC694"
  - "\uB0C9\uAC01 \uB4DC\uB860\uC740 \uB9DE\uD78C \uC810\uC561\uC744 \uB290\uB9AC\uAC8C
    \uB9CC\uB4E4\uC5B4\uC694"
  - "\uC18C\uAC01 \uB4DC\uB860\uC740 2\uB4F1\uAE09\uBD80\uD130 \uC591\uC606 \uB808\uC778\uAE4C\uC9C0
    \uD0DC\uC6CC\uC694"
  - "\uD761\uC785 \uB4DC\uB860 3\uB4F1\uAE09 \uBE54\uC740 \uB450 \uB9C8\uB9AC\uB97C
    \uAD00\uD1B5\uD574\uC694"
  - "\uBCC0\uC774 \uC810\uC561\uC740 \uD574\uCE58\uB97C 3\uC774\uB098 \uAE4E\uC544\uC694.
    \uBA3C\uC800 \uB178\uB824\uC694"
  - "\uB4DC\uB798\uADF8 \uC911 \uC6B0\uD074\uB9AD\uD558\uBA74 \uC6D0\uB798 \uCE78\uC73C\uB85C
    \uB3CC\uC544\uAC00\uC694"
  - "\uB4DC\uB860\uC740 \uD574\uCE58\uC5D0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC810\uC561\uBD80\uD130
    \uB178\uB824\uC694"
  - "\uC6E8\uC774\uBE0C\uB97C \uB9C9\uC73C\uBA74 \uBCF4\uB108\uC2A4 \uCF54\uC778\uC774
    \uB4E4\uC5B4\uC640\uC694"
